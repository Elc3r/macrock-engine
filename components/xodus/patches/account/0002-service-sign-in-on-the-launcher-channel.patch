--- /dev/null
+++ b/crates/xodus-service/src/account.rs
@@ -0,0 +1,277 @@
+//! The account's operations the launcher asks for on its channel.
+
+use xodus::models::live::{DAProperty, ExchangeUserTokenOutcome};
+use xodus::models::secrets::{LegacyToken, Token, User};
+use xodus::models::soap;
+use xodus::proto::xodus::failure::Reason;
+use xodus::proto::xodus::sign_in_result::Outcome;
+use xodus::proto::xodus::{Failure, SignIn, SignInResult, SignedIn};
+use xodus::tokens::TokenManager;
+use xodus::tokens::device::DeviceError;
+
+use crate::simple_context::SimpleContext;
+
+// The client and scopes of xodus-cli login, whose flow signing in follows.
+const CLIENT_ID: &str = "000000004424da1f";
+const USER_AUTH_SCOPE: &str = "scope=service::user.auth.xboxlive.com::MBI_SSL&api-version=2.0";
+const TOKEN_BROKER_SCOPE: &str = "http://Passport.NET/tb";
+
+/// Exchanges what the sign-in page posted for the account's tokens and keeps them with the user,
+/// registering the device first if it is not registered yet.
+pub async fn sign_in(context: &SimpleContext, request: SignIn) -> SignInResult {
+    let outcome = exchange(context, request)
+        .await
+        .unwrap_or_else(Outcome::Failure);
+    SignInResult {
+        outcome: Some(outcome),
+    }
+}
+
+async fn exchange(context: &SimpleContext, request: SignIn) -> Result<Outcome, Failure> {
+    let page = serde_json::from_str::<DAProperty>(&request.server_data)
+        .map_err(|_| failure(Reason::InvalidServerData))?;
+    let device = context.register_device().await.map_err(|err| {
+        tracing::warn!("The device could not sign in: {err}");
+        failure(match err {
+            DeviceError::Keychain(_) => Reason::Keychain,
+            DeviceError::Microsoft(_) | DeviceError::NotRegistered => Reason::Unavailable,
+        })
+    })?;
+    let mut scopes = vec![(
+        USER_AUTH_SCOPE.to_string(),
+        Some(soap::PolicyReference::token_broker()),
+    )];
+    if request.inline_auth {
+        scopes.push((TOKEN_BROKER_SCOPE.to_string(), None));
+    }
+    let user = User {
+        puid: page.puid,
+        username: page.username.clone(),
+    };
+    let user_token = LegacyToken {
+        key_name: None,
+        token: page.da_token,
+        binary_secret: None,
+        tpm_key: None,
+        lifetime: soap::Timestamp {
+            id: None,
+            created: page.da_start_time,
+            expires: page.da_expires,
+        },
+    };
+    let exchanged = xodus::api::live::exchange_user_token(
+        &context.client,
+        user_token,
+        page.username,
+        device,
+        Some(page.sts_inline_flow_token),
+        None,
+        CLIENT_ID.to_string(),
+        &scopes,
+    )
+    .await
+    .map_err(|err| {
+        tracing::warn!("Microsoft did not exchange the user's token: {err}");
+        failure(Reason::Unavailable)
+    })?;
+    conclude(context.tokens(), &user, exchanged)
+}
+
+/// What Microsoft's answer to the exchange means for the launcher.
+fn conclude(
+    tokens: &TokenManager,
+    user: &User,
+    exchanged: ExchangeUserTokenOutcome,
+) -> Result<Outcome, Failure> {
+    use soap::BodyContent::{RequestSecurityTokenResponse, RequestSecurityTokenResponseCollection};
+
+    match exchanged {
+        ExchangeUserTokenOutcome::Fault(Some(soap::PP {
+            inline_auth_url: Some(url),
+            ..
+        })) => {
+            tracing::info!("Microsoft asked for another sign-in page");
+            Ok(Outcome::InlineAuthUrl(url))
+        }
+        ExchangeUserTokenOutcome::Fault(pp) => {
+            let status = pp
+                .and_then(|pp| pp.req_status)
+                .and_then(|status| hresult(&status))
+                .unwrap_or_default();
+            tracing::warn!("Microsoft refused the sign-in: {status:#010x}");
+            Err(Failure {
+                reason: Reason::Refused.into(),
+                status,
+            })
+        }
+        ExchangeUserTokenOutcome::Issued(RequestSecurityTokenResponseCollection(collection)) => {
+            keep(tokens, user, collection.security_tokens)
+        }
+        ExchangeUserTokenOutcome::Issued(RequestSecurityTokenResponse(response)) => {
+            keep(tokens, user, vec![*response])
+        }
+        ExchangeUserTokenOutcome::Issued(_) => {
+            tracing::warn!("Microsoft answered the sign-in without tokens");
+            Err(failure(Reason::Unavailable))
+        }
+    }
+}
+
+/// Keeps the issued tokens, then the user, which marks a sign-in that completed.
+fn keep(
+    tokens: &TokenManager,
+    user: &User,
+    issued: Vec<soap::RequestSecurityTokenResponse>,
+) -> Result<Outcome, Failure> {
+    issued
+        .into_iter()
+        .try_for_each(|response| {
+            let address = response.applies_to.endpoint_reference.address.clone();
+            let token = Token::from(response);
+            // Requests look up the user's STS token, a legacy one, by its key name.
+            let address = match &token {
+                Token::Legacy(LegacyToken {
+                    key_name: Some(name),
+                    ..
+                }) => name.clone(),
+                _ => address,
+            };
+            tokens.save_user_token(address, token)
+        })
+        .and_then(|()| tokens.save_user(user))
+        .map_err(|err| {
+            tracing::error!("The sign-in's tokens were not kept: {err}");
+            failure(Reason::Keychain)
+        })?;
+    tracing::info!("Signed in");
+    Ok(Outcome::SignedIn(SignedIn {}))
+}
+
+fn failure(reason: Reason) -> Failure {
+    Failure {
+        reason: reason.into(),
+        status: 0,
+    }
+}
+
+/// Microsoft's status, written as `0x80048821`.
+fn hresult(status: &str) -> Option<u32> {
+    u32::from_str_radix(status.strip_prefix("0x")?, 16).ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use super::*;
+
+    fn user() -> User {
+        User {
+            puid: "0001000000000001".to_string(),
+            username: "player@example.com".to_string(),
+        }
+    }
+
+    fn fault(inline_auth_url: Option<&str>, req_status: Option<&str>) -> ExchangeUserTokenOutcome {
+        ExchangeUserTokenOutcome::Fault(Some(soap::PP {
+            xmlns_psf: None,
+            server_version: None,
+            req_status: req_status.map(str::to_string),
+            inline_auth_url: inline_auth_url.map(str::to_string),
+            inline_end_auth_url: None,
+            auth_state_internal: None,
+            user_session_key: None,
+        }))
+    }
+
+    fn compact_token(address: &str, value: &str) -> soap::RequestSecurityTokenResponse {
+        soap::RequestSecurityTokenResponse {
+            token_type: "urn:passport:compact".to_string(),
+            applies_to: soap::AppliesTo {
+                endpoint_reference: soap::EndpointReference {
+                    address: address.to_string(),
+                },
+            },
+            lifetime: soap::Timestamp {
+                id: None,
+                created: "2026-10-10T00:00:00Z".to_string(),
+                expires: "2026-10-11T00:00:00Z".to_string(),
+            },
+            requested_security_token: soap::RequestedSecurityToken {
+                encrypted_data: None,
+                binary_security_token: Some(soap::BinarySecurityTokenRes {
+                    id: "Compact0".to_string(),
+                    value: value.to_string(),
+                    value_type: None,
+                }),
+            },
+            requested_proof_token: None,
+        }
+    }
+
+    #[tokio::test]
+    async fn refuses_data_that_no_sign_in_page_posted() {
+        let context = SimpleContext::new(Arc::new(TokenManager::with_memory()));
+        let request = SignIn {
+            server_data: r#"{"sDAToken": "t=token"}"#.to_string(),
+            inline_auth: false,
+        };
+        assert_eq!(
+            sign_in(&context, request).await.outcome,
+            Some(Outcome::Failure(failure(Reason::InvalidServerData)))
+        );
+    }
+
+    #[test]
+    fn sends_the_user_to_the_page_microsoft_names() {
+        let tokens = TokenManager::with_memory();
+        let url = "https://login.live.com/inline";
+        let outcome = conclude(&tokens, &user(), fault(Some(url), None));
+        assert_eq!(outcome, Ok(Outcome::InlineAuthUrl(url.to_string())));
+        assert!(tokens.get_user().is_err());
+    }
+
+    #[test]
+    fn reports_the_status_microsoft_refused_with() {
+        let tokens = TokenManager::with_memory();
+        let outcome = conclude(&tokens, &user(), fault(None, Some("0x80048821")));
+        assert_eq!(
+            outcome,
+            Err(Failure {
+                reason: Reason::Refused.into(),
+                status: 0x8004_8821,
+            })
+        );
+        assert!(tokens.get_user().is_err());
+    }
+
+    #[test]
+    fn keeps_the_issued_tokens_and_the_user() {
+        let tokens = TokenManager::with_memory();
+        let issued = soap::RequestSecurityTokenResponseCollection {
+            security_tokens: vec![
+                compact_token("user.auth.xboxlive.com", "t=user"),
+                compact_token("http://Passport.NET/tb", "t=broker"),
+            ],
+        };
+        let exchanged = ExchangeUserTokenOutcome::Issued(
+            soap::BodyContent::RequestSecurityTokenResponseCollection(issued),
+        );
+        assert_eq!(
+            conclude(&tokens, &user(), exchanged),
+            Ok(Outcome::SignedIn(SignedIn {}))
+        );
+        assert!(matches!(
+            tokens.get_user_token_for("user.auth.xboxlive.com"),
+            Ok(Some(Token::Compact(token))) if token == "t=user"
+        ));
+        assert!(matches!(
+            tokens.get_user_token_for("http://Passport.NET/tb"),
+            Ok(Some(Token::Compact(token))) if token == "t=broker"
+        ));
+        assert_eq!(
+            tokens.get_user().map(|user| user.username).ok(),
+            Some("player@example.com".to_string())
+        );
+    }
+}
