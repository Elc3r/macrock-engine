diff --git a/crates/xodus/proto/xodus/launcher.proto b/crates/xodus/proto/xodus/launcher.proto
index 9e95149bb18b0e48e5c7ba28cf82a3382f39401b..734e143444129b40230e1f061ebcc9392bf74faa 100644
--- a/crates/xodus/proto/xodus/launcher.proto
+++ b/crates/xodus/proto/xodus/launcher.proto
@@ -8,3 +8,44 @@ package xodus;
 message Hello {
     uint32 protocol = 1;
 }
+
+// LAUNCHER_SIGN_IN: what Microsoft's sign-in page posted, for the service to exchange for the
+// account's tokens. The device is registered first if it is not yet.
+message SignIn {
+    // The JSON of the page's ServerData. The service reads only sDAToken, sDASessionKey,
+    // sDAStartTime, sDAExpires, sSTSInlineFlowToken, sSigninName and K, so it may hold only those.
+    string server_data = 1;
+    // Whether the page is the one a SignInResult's inline_auth_url named.
+    bool inline_auth = 2;
+}
+
+// The response to LAUNCHER_SIGN_IN.
+message SignInResult {
+    oneof outcome {
+        // The service keeps the tokens Microsoft issued, with the user.
+        SignedIn signed_in = 1;
+        // Microsoft wants the user on this page first; its ServerData comes in a new SIGN_IN.
+        string inline_auth_url = 2;
+        Failure failure = 3;
+    }
+}
+
+message SignedIn {}
+
+// Why a request of the launcher failed.
+message Failure {
+    enum Reason {
+        REASON_UNSPECIFIED = 0;
+        // A SIGN_IN's server_data is not what a sign-in page posts.
+        REASON_INVALID_SERVER_DATA = 1;
+        // Microsoft could not be reached, or gave an answer the service does not understand.
+        REASON_UNAVAILABLE = 2;
+        // Microsoft refused the sign-in, or the user's token: the user must sign in again.
+        REASON_REFUSED = 3;
+        // The keychain refused access to the credentials.
+        REASON_KEYCHAIN = 4;
+    }
+    Reason reason = 1;
+    // For REASON_REFUSED, Microsoft's status (an HRESULT such as 0x80048821) when it gave one.
+    uint32 status = 2;
+}
