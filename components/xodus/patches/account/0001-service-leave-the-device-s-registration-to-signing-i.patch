         let _renewal = DEVICE_TOKEN_RENEWAL.lock().await;
-        xodus::tokens::device::ensure_device_credentials(&self.client, &self.tokens).await
+        xodus::tokens::device::device_token(&self.client, &self.tokens).await
     }
 }
