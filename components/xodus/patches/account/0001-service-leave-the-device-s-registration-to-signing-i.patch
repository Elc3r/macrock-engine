 pub async fn ensure_device_credentials(
     client: &reqwest::Client,
     tokens: &TokenManager,
+) -> Result<LegacyToken, DeviceError> {
+    if matches!(
+        tokens.get_device_license(),
+        Err(TokenStoreError::NotFound | TokenStoreError::Serde(_))
+    ) {
+        provision_device(client, tokens).await?;
+    }
+    device_token(client, tokens).await
+}
+
+/// The device's STS token, re-authenticating the device when the token is missing or about to
+/// expire, persisted through `tokens`. A device that was never registered is an error: only
+/// `ensure_device_credentials` registers one.
+pub async fn device_token(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
 ) -> Result<LegacyToken, DeviceError> {
     let license = match tokens.get_device_license() {
         Ok(license) => license,
         Err(TokenStoreError::NotFound | TokenStoreError::Serde(_)) => {
-            provision_device(client, tokens).await?
+            return Err(DeviceError::NotRegistered);
         }
         Err(err) => return Err(err.into()),
     };
