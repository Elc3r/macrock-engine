+async fn gamertag(context: &SimpleContext) -> Result<String, Failure> {
+    use soap::BodyContent::{RequestSecurityTokenResponse, RequestSecurityTokenResponseCollection};
+
+    let tokens = context.tokens();
+    let (Some(user), Some(Token::Legacy(user_sts))) = (
+        stored(tokens.get_user())?,
+        stored(tokens.get_user_sts_token())?,
+    ) else {
+        return Err(failure(Reason::NotSignedIn));
+    };
+    let device = context.device_token().await.map_err(device_failure)?;
+    let unavailable = |err: &dyn std::fmt::Display| {
+        tracing::warn!("No Xbox profile: {err}");
+        failure(Reason::Unavailable)
+    };
+    let exchanged = xodus::api::live::exchange_user_token(
+        &context.client,
+        user_sts,
+        user.username,
+        device,
+        None,
+        Some("Silent".to_string()),
+        XBOX_APP_ID.to_string(),
+        &[(
+            XBOX_USER_SCOPE.to_string(),
+            Some(soap::PolicyReference::mbi_ssl()),
+        )],
+    )
+    .await
+    .map_err(|err| unavailable(&err))?;
+    let response = match exchanged {
+        ExchangeUserTokenOutcome::Issued(RequestSecurityTokenResponseCollection(
+            mut collection,
+        )) if !collection.security_tokens.is_empty() => collection.security_tokens.remove(0),
+        ExchangeUserTokenOutcome::Issued(RequestSecurityTokenResponse(response)) => *response,
+        ExchangeUserTokenOutcome::Issued(_) => return Err(unavailable(&"no user token")),
+        ExchangeUserTokenOutcome::Fault(pp) => {
+            tokens.note_user_token_refused(true);
+            let refusal = refusal(pp);
+            tracing::warn!(
+                "Microsoft refused the user's token: {:#010x}",
+                refusal.status
+            );
+            return Err(refusal);
+        }
+    };
+    tokens.note_user_token_refused(false);
+    let Token::Compact(ticket) = Token::from(response) else {
+        return Err(unavailable(&"not a compact user token"));
+    };
+    let user_token = authenticate_xbox_user(&context.client, ticket)
+        .await
+        .map_err(|err| unavailable(&err))?;
+    let xsts = request_xsts_token(&context.client, user_token.token, XBOX_LIVE)
+        .await
+        .map_err(|err| unavailable(&err))?;
+    xsts.gamertag()
+        .map(str::to_string)
+        .ok_or_else(|| unavailable(&"no gamertag in the Xbox token"))
+}
+
+/// A keychain read: a missing or unreadable item is None, a refusal a failure.
+fn stored<T>(read: Result<T, TokenStoreError>) -> Result<Option<T>, Failure> {
+    match read {
+        Ok(value) => Ok(Some(value)),
+        Err(TokenStoreError::NotFound | TokenStoreError::Serde(_)) => Ok(None),
+        Err(err) => {
+            tracing::error!("{err}");
+            Err(failure(Reason::Keychain))
+        }
+    }
+}
+
+fn device_failure(err: DeviceError) -> Failure {
+    tracing::warn!("The device has no token: {err}");
+    failure(match err {
+        DeviceError::Keychain(_) => Reason::Keychain,
+        DeviceError::Microsoft(_) => Reason::Unavailable,
+        DeviceError::NotRegistered => Reason::NotSignedIn,
+    })
+}
+
+fn refusal(pp: Option<soap::PP>) -> Failure {
+    let status = pp
+        .and_then(|pp| pp.req_status)
+        .and_then(|status| hresult(&status))
+        .unwrap_or_default();
+    Failure {
+        reason: Reason::Refused.into(),
+        status,
+    }
 }
 
