+fn state(tokens: &TokenManager) -> Result<State, Failure> {
+    if stored(tokens.get_device_license())?.is_none() {
+        return Ok(State::Empty);
+    }
+    let signed_in =
+        stored(tokens.get_user())?.is_some() && stored(tokens.get_user_sts_token())?.is_some();
+    Ok(if signed_in {
+        State::SignedIn
+    } else {
+        State::DeviceOnly
+    })
+}
