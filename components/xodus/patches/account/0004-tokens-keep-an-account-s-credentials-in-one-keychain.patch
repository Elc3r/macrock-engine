diff --git a/crates/xodus/src/tokens/backend/keychain.rs b/crates/xodus/src/tokens/backend/keychain.rs
index 906cd583facac3dc9d76918f2a602c75547ce858..50f5c678e7e9896f292860182a8c7476796d3174 100644
--- a/crates/xodus/src/tokens/backend/keychain.rs
+++ b/crates/xodus/src/tokens/backend/keychain.rs
@@ -1,25 +1,206 @@
+use std::collections::HashMap;
+use std::sync::Mutex;
+
 use crate::tokens::store::{TokenBackend, TokenStoreError};
 
-pub struct KeychainBackend;
+/// The item that holds the credentials, in the keychain service.
+const ITEM: &str = "credentials";
+
+type Contents = HashMap<String, serde_json::Value>;
+
+/// All the credentials of an account in one item of its keychain service. macOS asks the user
+/// once per item for each new build of the service (the item names the builds it trusts by their
+/// code directory hash), so one item is one prompt per account. The item is read once, then kept
+/// in memory. Values are JSON documents, as the token manager writes them.
+pub struct KeychainBackend {
+    service: String,
+    contents: Mutex<Option<Contents>>,
+}
+
+impl KeychainBackend {
+    pub fn new(service: String) -> Self {
+        Self {
+            service,
+            contents: Mutex::new(None),
+        }
+    }
+
+    fn entry(&self) -> Result<keyring_core::Entry, TokenStoreError> {
+        Ok(keyring_core::Entry::new(&self.service, ITEM)?)
+    }
+
+    fn loaded<'a>(
+        &self,
+        cached: &'a mut Option<Contents>,
+    ) -> Result<&'a mut Contents, TokenStoreError> {
+        let contents = match cached.take() {
+            Some(contents) => contents,
+            None => match self.entry()?.get_secret() {
+                Ok(bytes) => serde_json::from_slice(&bytes)?,
+                Err(keyring_core::Error::NoEntry) => Contents::new(),
+                Err(e) => return Err(e.into()),
+            },
+        };
+        Ok(cached.insert(contents))
+    }
+
+    /// Writes the changed contents, if they changed, and keeps them only once they are written.
+    /// Without any credential left, the item goes.
+    fn update(&self, change: impl FnOnce(&mut Contents)) -> Result<(), TokenStoreError> {
+        let mut cached = self.contents.lock().unwrap();
+        let contents = self.loaded(&mut cached)?;
+        let mut changed = contents.clone();
+        change(&mut changed);
+        if changed == *contents {
+            return Ok(());
+        }
+        let entry = self.entry()?;
+        if changed.is_empty() {
+            match entry.delete_credential() {
+                Ok(()) | Err(keyring_core::Error::NoEntry) => {}
+                #[cfg(target_os = "macos")]
+                Err(e) if legacy::created_by_another_build(&e) => {
+                    legacy::delete(&self.service, ITEM)?
+                }
+                Err(e) => return Err(e.into()),
+            }
+        } else {
+            entry.set_secret(&serde_json::to_vec(&changed)?)?;
+        }
+        *contents = changed;
+        Ok(())
+    }
+}
+
+/// The keychain store deletes with SecItemDelete, which refuses an item that another build of the
+/// service created; the legacy SecKeychainItemDelete deletes it.
+#[cfg(target_os = "macos")]
+mod legacy {
+    use core_foundation::base::TCFType;
+    use security_framework::base::Error;
+    use security_framework::item::{ItemClass, ItemSearchOptions, Reference, SearchResult};
+    use security_framework::os::macos::keychain::{SecKeychain, SecPreferencesDomain};
+    use security_framework_sys::keychain_item::SecKeychainItemDelete;
+
+    const ERR_SEC_INVALID_OWNER_EDIT: i32 = -25244;
+
+    pub fn created_by_another_build(error: &keyring_core::Error) -> bool {
+        let keyring_core::Error::NoStorageAccess(error) = error else {
+            return false;
+        };
+        error
+            .downcast_ref::<Error>()
+            .is_some_and(|error| error.code() == ERR_SEC_INVALID_OWNER_EDIT)
+    }
+
+    /// Deletes the generic password items of `service` and `account` in the user's keychain,
+    /// found by reference: their data is not read.
+    pub fn delete(service: &str, account: &str) -> Result<(), keyring_core::Error> {
+        let failure = |error: Error| keyring_core::Error::PlatformFailure(Box::new(error));
+        let keychain =
+            SecKeychain::default_for_domain(SecPreferencesDomain::User).map_err(failure)?;
+        let found = ItemSearchOptions::new()
+            .keychains(&[keychain])
+            .class(ItemClass::generic_password())
+            .service(service)
+            .account(account)
+            .load_refs(true)
+            .search()
+            .map_err(failure)?;
+        for result in found {
+            if let SearchResult::Ref(Reference::KeychainItem(item)) = result {
+                // SAFETY: a keychain item the search returned, alive for the call.
+                let status = unsafe { SecKeychainItemDelete(item.as_concrete_TypeRef()) };
+                if status != 0 {
+                    return Err(failure(Error::from_code(status)));
+                }
+            }
+        }
+        Ok(())
+    }
+}
 
 impl TokenBackend for KeychainBackend {
     fn get(&self, key: &str) -> Result<Option<Vec<u8>>, TokenStoreError> {
-        let entry = crate::secrets::get_entry(key)?;
-        match entry.get_secret() {
-            Ok(bytes) => Ok(Some(bytes)),
-            Err(keyring_core::Error::NoEntry) => Ok(None),
-            Err(e) => Err(e.into()),
-        }
+        let mut cached = self.contents.lock().unwrap();
+        let contents = self.loaded(&mut cached)?;
+        Ok(contents.get(key).map(serde_json::to_vec).transpose()?)
     }
 
     fn set(&self, key: &str, value: &[u8]) -> Result<(), TokenStoreError> {
-        Ok(crate::secrets::get_entry(key)?.set_secret(value)?)
+        let value = serde_json::from_slice(value)?;
+        self.update(|contents| {
+            contents.insert(key.to_string(), value);
+        })
     }
 
     fn remove(&self, key: &str) -> Result<(), TokenStoreError> {
-        match crate::secrets::get_entry(key)?.delete_credential() {
-            Ok(()) | Err(keyring_core::Error::NoEntry) => Ok(()),
-            Err(e) => Err(e.into()),
-        }
+        self.update(|contents| {
+            contents.remove(key);
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Once;
+
+    use super::*;
+
+    /// A keychain service of the sample store, which keeps entries in memory.
+    fn service(name: &str) -> String {
+        static STORE: Once = Once::new();
+        STORE.call_once(|| {
+            keyring_core::set_default_store(keyring_core::sample::Store::new().unwrap())
+        });
+        format!("xodus test {name}")
+    }
+
+    fn has_item(service: &str, item: &str) -> bool {
+        keyring_core::Entry::new(service, item)
+            .unwrap()
+            .get_secret()
+            .is_ok()
+    }
+
+    #[test]
+    fn keeps_every_credential_in_one_item() {
+        let service = service("one item");
+        let backend = KeychainBackend::new(service.clone());
+        backend.set("dev_license", br#"{"puid":"1"}"#).unwrap();
+        backend.set("user-DA", br#"{"username":"player"}"#).unwrap();
+
+        let reopened = KeychainBackend::new(service.clone());
+        assert_eq!(
+            reopened.get("dev_license").unwrap(),
+            Some(br#"{"puid":"1"}"#.to_vec())
+        );
+        assert_eq!(
+            reopened.get("user-DA").unwrap(),
+            Some(br#"{"username":"player"}"#.to_vec())
+        );
+        assert!(has_item(&service, ITEM));
+        assert!(!has_item(&service, "dev_license"));
+    }
+
+    #[test]
+    fn removes_the_item_with_the_last_credential() {
+        let service = service("last credential");
+        let backend = KeychainBackend::new(service.clone());
+        backend.set("dev_license", br#"{"puid":"1"}"#).unwrap();
+        backend.set("user-DA", br#"{"username":"player"}"#).unwrap();
+
+        backend.remove("user-DA").unwrap();
+        assert!(has_item(&service, ITEM));
+        backend.remove("dev_license").unwrap();
+        assert!(!has_item(&service, ITEM));
+        assert_eq!(backend.get("dev_license").unwrap(), None);
+    }
+
+    #[test]
+    fn removing_a_missing_credential_succeeds() {
+        let backend = KeychainBackend::new(service("missing credential"));
+        backend.remove("user-DA").unwrap();
+        assert_eq!(backend.get("user-DA").unwrap(), None);
     }
 }
