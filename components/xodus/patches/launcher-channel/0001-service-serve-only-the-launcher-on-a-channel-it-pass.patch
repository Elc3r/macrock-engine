 }
diff --git a/crates/xodus/proto/xodus/launcher.proto b/crates/xodus/proto/xodus/launcher.proto
new file mode 100644
index 0000000000000000000000000000000000000000..9e95149bb18b0e48e5c7ba28cf82a3382f39401b
--- /dev/null
+++ b/crates/xodus/proto/xodus/launcher.proto
@@ -0,0 +1,10 @@
+syntax = "proto3";
+
+// The launcher channel's messages (macrock). The launcher passes the channel as the service's
+// standard input; its frames carry PROTO_MAGIC, a XodusMessageType and one of these messages.
+package xodus;
+
+// LAUNCHER_HELLO, and its response: the version of the channel's protocol.
+message Hello {
+    uint32 protocol = 1;
+}
