diff --git a/crates/xodus-service/src/launcher.rs b/crates/xodus-service/src/launcher.rs
new file mode 100644
index 0000000000000000000000000000000000000000..03dd8c965268026bc298f6d31d8f435d9d1a48a8
--- /dev/null
+++ b/crates/xodus-service/src/launcher.rs
@@ -0,0 +1,190 @@
+//! The launcher's channel: a socket the launcher passes as the service's standard input, so that
+//! only the launcher speaks on it. Its frames carry PROTO_MAGIC and the messages of
+//! `launcher.proto`; closing it stops the service.
+
+use std::os::fd::FromRawFd;
+
+use prost::Message;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::UnixStream;
+use xodus::proto::xodus::{Hello, XodusMessageType};
+
+use crate::PROTO_MAGIC;
+
+/// The version of the channel's messages, which HELLO tells the launcher.
+const PROTOCOL: u32 = 1;
+
+/// The identifier the launcher is signed with.
+#[cfg(target_os = "macos")]
+const LAUNCHER_IDENTIFIER: &str = "dev.macrock.launcher";
+
+/// Opens the channel when XODUS_LAUNCHER_CHANNEL is `stdin`. The keychain trusts a signed
+/// service, whoever runs it, so a signed service serves only a launcher signed with its own
+/// certificate, and checks that before it touches the keychain. A service signed ad hoc gets no
+/// trust from the keychain for what a release created, and may run without the channel.
+pub fn open() -> Result<Option<UnixStream>, String> {
+    let requested = std::env::var("XODUS_LAUNCHER_CHANNEL").is_ok_and(|value| value == "stdin");
+    let certificate = own_certificate()?;
+    if !requested {
+        return match certificate {
+            Some(_) => Err("a signed service needs the launcher channel".to_string()),
+            None => Ok(None),
+        };
+    }
+    match certificate {
+        Some(certificate) => check_peer(&certificate)?,
+        None => tracing::warn!("Signed ad hoc: the launcher channel's peer is not checked"),
+    }
+    // SAFETY: standard input is not used anywhere else; the stream takes it over.
+    let stream = unsafe { std::os::unix::net::UnixStream::from_raw_fd(0) };
+    stream
+        .set_nonblocking(true)
+        .and_then(|()| UnixStream::from_std(stream))
+        .map(Some)
+        .map_err(|err| format!("the launcher channel: {err}"))
+}
+
+/// Answers the launcher's messages until it closes the channel.
+pub async fn serve(mut channel: UnixStream) {
+    loop {
+        let mut header = [0; 8];
+        if let Err(err) = channel.read_exact(&mut header).await {
+            if err.kind() != std::io::ErrorKind::UnexpectedEof {
+                tracing::error!("Failed to read from the launcher channel: {err}");
+            }
+            return;
+        }
+        let magic = u32::from_le_bytes([header[0], header[1], header[2], header[3]]);
+        let message_type = u16::from_le_bytes([header[4], header[5]]);
+        let size = u16::from_le_bytes([header[6], header[7]]);
+        if magic != PROTO_MAGIC {
+            tracing::error!("Unknown magic on the launcher channel");
+            return;
+        }
+        let mut payload = vec![0; usize::from(size)];
+        if let Err(err) = channel.read_exact(&mut payload).await {
+            tracing::error!("Failed to read from the launcher channel: {err}");
+            return;
+        }
+        let reply = match XodusMessageType::try_from(i32::from(message_type)) {
+            Ok(XodusMessageType::LauncherHello) => Hello { protocol: PROTOCOL }.encode_to_vec(),
+            _ => Vec::new(),
+        };
+        let frame = crate::connection::encode_message(PROTO_MAGIC, message_type + 1, reply);
+        if let Err(err) = channel.write_all(&frame).await {
+            tracing::error!("Failed to answer on the launcher channel: {err}");
+            return;
+        }
+    }
+}
+
+/// The DER of the certificate the service is signed with, or None when it is signed ad hoc.
+#[cfg(target_os = "macos")]
+fn own_certificate() -> Result<Option<Vec<u8>>, String> {
+    use core_foundation::array::CFArray;
+    use core_foundation::base::{CFType, TCFType};
+    use core_foundation::dictionary::CFDictionary;
+    use core_foundation::string::{CFString, CFStringRef};
+    use security_framework::certificate::SecCertificate;
+    use security_framework::os::macos::code_signing::{Flags, SecCode};
+
+    #[link(name = "Security", kind = "framework")]
+    unsafe extern "C" {
+        fn SecCodeCopySigningInformation(
+            code: *const std::ffi::c_void,
+            flags: u32,
+            information: *mut core_foundation::dictionary::CFDictionaryRef,
+        ) -> i32;
+        static kSecCodeInfoCertificates: CFStringRef;
+    }
+    // kSecCSSigningInformation: include the certificate chain.
+    const SIGNING_INFORMATION: u32 = 1 << 1;
+
+    let code = SecCode::for_self(Flags::NONE).map_err(|err| format!("code signing: {err}"))?;
+    let mut information = std::ptr::null();
+    // SAFETY: the call writes a dictionary the caller owns, under the create rule.
+    let status = unsafe {
+        SecCodeCopySigningInformation(
+            code.as_concrete_TypeRef().cast(),
+            SIGNING_INFORMATION,
+            &mut information,
+        )
+    };
+    if status != 0 || information.is_null() {
+        return Err(format!("code signing: OSStatus {status}"));
+    }
+    // SAFETY: a dictionary returned under the create rule; the key is a constant of Security.
+    let (information, key) = unsafe {
+        (
+            CFDictionary::<CFString, CFType>::wrap_under_create_rule(information),
+            CFString::wrap_under_get_rule(kSecCodeInfoCertificates),
+        )
+    };
+    let Some(certificates) = information
+        .find(&key)
+        .and_then(|value| value.downcast::<CFArray>())
+    else {
+        return Ok(None);
+    };
+    // SAFETY: kSecCodeInfoCertificates is an array of certificates, the leaf first.
+    let leaf = certificates.get(0).map(|leaf| unsafe {
+        SecCertificate::wrap_under_get_rule((*leaf).cast_mut().cast()).to_der()
+    });
+    Ok(leaf)
+}
+
+#[cfg(not(target_os = "macos"))]
+fn own_certificate() -> Result<Option<Vec<u8>>, String> {
+    Ok(None)
+}
+
+/// Checks that the process at the other end of standard input is the launcher, signed with
+/// `certificate`: only the holder of that certificate's key can sign such a launcher.
+#[cfg(target_os = "macos")]
+fn check_peer(certificate: &[u8]) -> Result<(), String> {
+    use core_foundation::base::TCFType;
+    use core_foundation::data::CFData;
+    use security_framework::os::macos::code_signing::{
+        Flags, GuestAttributes, SecCode, SecRequirement,
+    };
+    use sha1::{Digest, Sha1};
+
+    let mut token = [0u8; 32];
+    let mut length = token.len() as libc::socklen_t;
+    // SAFETY: getsockopt writes at most `length` bytes into `token`.
+    let result = unsafe {
+        libc::getsockopt(
+            0,
+            libc::SOL_LOCAL,
+            libc::LOCAL_PEERTOKEN,
+            token.as_mut_ptr().cast(),
+            &mut length,
+        )
+    };
+    if result != 0 || length as usize != token.len() {
+        return Err(format!(
+            "the launcher channel has no peer: {}",
+            std::io::Error::last_os_error()
+        ));
+    }
+    let token = CFData::from_buffer(&token);
+    let mut attributes = GuestAttributes::new();
+    attributes.set_audit_token(token.as_concrete_TypeRef());
+    let peer = SecCode::copy_guest_with_attribues(None, &attributes, Flags::NONE)
+        .map_err(|err| format!("the launcher channel's peer: {err}"))?;
+    let leaf: String = Sha1::digest(certificate)
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect();
+    let requirement: SecRequirement =
+        format!(r#"identifier "{LAUNCHER_IDENTIFIER}" and certificate leaf = H"{leaf}""#)
+            .parse()
+            .map_err(|err| format!("the launcher's requirement: {err}"))?;
+    peer.check_validity(Flags::NONE, &requirement)
+        .map_err(|_| "the launcher channel's peer is not the launcher".to_string())
+}
+
+#[cfg(not(target_os = "macos"))]
+fn check_peer(_certificate: &[u8]) -> Result<(), String> {
+    Ok(())
+}
