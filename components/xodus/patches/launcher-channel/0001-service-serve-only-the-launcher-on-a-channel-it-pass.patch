@@ -14,6 +14,7 @@ use xodus::tokens::TokenManager;
 use xodus::tokens::device::DeviceError;
 
 mod connection;
+mod launcher;
 mod simple_context;
 mod utils;
 
@@ -28,6 +29,8 @@ mod status {
     pub const CANT_CREATE: u8 = 73;
     /// The keychain refused access to the credentials.
     pub const NO_PERMISSION: u8 = 77;
+    /// The launcher channel is missing, or its peer is not the launcher.
+    pub const CONFIG: u8 = 78;
 }
 
 fn main() -> ExitCode {
@@ -69,6 +72,22 @@ async fn run() -> ExitCode {
     // Installed before anything that can take long, so that SIGINT or SIGTERM stops the service
     // cleanly at any time.
     let mut stop = StopSignals::install().expect("Unable to handle SIGINT and SIGTERM");
+    let channel = match launcher::open() {
+        Ok(channel) => channel,
+        Err(message) => {
+            tracing::error!("{message}");
+            return ExitCode::from(status::CONFIG);
+        }
+    };
+    // The launcher closing its channel stops the service as a signal does.
+    let closed = CancellationToken::new();
+    if let Some(channel) = channel {
+        let closed = closed.clone();
+        tokio::spawn(async move {
+            launcher::serve(channel).await;
+            closed.cancel();
+        });
+    }
     // Reading the keychain blocks the thread while macOS asks the user, so the start runs as a
     // task of its own.
     let started = tokio::select! {
@@ -77,6 +96,7 @@ async fn run() -> ExitCode {
             Err(err) => std::panic::resume_unwind(err.into_panic()),
         },
         () = stop.received() => return ExitCode::SUCCESS,
+        () = closed.cancelled() => return ExitCode::SUCCESS,
     };
     let tokens = match started {
         Ok(started) => started,
@@ -119,6 +139,7 @@ async fn run() -> ExitCode {
                 Err(err) => tracing::warn!("Failed to accept a connection: {err}"),
             },
             () = stop.received() => break,
+            () = closed.cancelled() => break,
         }
     }
     cancellation.cancel();
