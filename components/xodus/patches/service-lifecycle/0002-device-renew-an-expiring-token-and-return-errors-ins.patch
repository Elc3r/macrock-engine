+/// Why the device has no usable credentials.
+#[derive(Debug, thiserror::Error)]
+pub enum DeviceError {
+    #[error("keychain: {0}")]
+    Keychain(#[from] TokenStoreError),
+    #[error("Microsoft did not register or authenticate the device: {0}")]
+    Microsoft(String),
+}
+
+/// Provisions a device if none is stored yet, re-authenticates it if its STS token is missing or
+/// about to expire, persists the result through `tokens`, and returns the device's STS token.
+pub async fn ensure_device_credentials(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+) -> Result<LegacyToken, DeviceError> {
+    let license = match tokens.get_device_license() {
+        Ok(license) => license,
+        Err(TokenStoreError::NotFound | TokenStoreError::Serde(_)) => {
+            provision_device(client, tokens).await?
+        }
+        Err(err) => return Err(err.into()),
+    };
+    match tokens.get_device_sts_token() {
+        Ok(Token::Legacy(token)) if !expires_soon(&token) => Ok(token),
+        Ok(_) | Err(TokenStoreError::NotFound | TokenStoreError::Serde(_)) => {
             reauthenticate_device(client, tokens, license).await
         }
-        Ok(_) => {}
+        Err(err) => Err(err.into()),
     }
 }
 
-async fn provision_device(client: &reqwest::Client, tokens: &TokenManager) {
+/// A token is renewed a few minutes before it expires, so that no request leaves with a token
+/// that expires on the way.
+fn expires_soon(token: &LegacyToken) -> bool {
+    chrono::DateTime::parse_from_rfc3339(&token.lifetime.expires).map_or(true, |expires| {
+        expires.with_timezone(&chrono::Utc) - chrono::TimeDelta::minutes(5) <= chrono::Utc::now()
+    })
+}
