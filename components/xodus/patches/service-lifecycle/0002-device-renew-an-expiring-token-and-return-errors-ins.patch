-fn save_device_sts_token(
-    tokens: &TokenManager,
-    resp: Box<crate::models::soap::RequestSecurityTokenResponse>,
-) {
+    let BodyContent::RequestSecurityTokenResponse(resp) = resp.body.body else {
+        return Err(DeviceError::Microsoft("no token in the answer".to_string()));
+    };
     let key_name = resp
         .requested_security_token
