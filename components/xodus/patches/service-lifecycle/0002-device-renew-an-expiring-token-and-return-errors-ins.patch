+#[cfg(test)]
+mod tests {
+    use super::expires_soon;
+    use crate::models::secrets::LegacyToken;
+    use crate::models::soap::Timestamp;
+
+    fn token(expires: chrono::DateTime<chrono::Utc>) -> LegacyToken {
+        LegacyToken {
+            key_name: None,
+            token: String::new(),
+            binary_secret: None,
+            tpm_key: None,
+            lifetime: Timestamp {
+                id: None,
+                created: String::new(),
+                expires: expires.to_rfc3339(),
+            },
+        }
+    }
+
+    #[test]
+    fn renews_a_token_that_expires_within_five_minutes() {
+        let now = chrono::Utc::now();
+        assert!(expires_soon(&token(now - chrono::TimeDelta::hours(1))));
+        assert!(expires_soon(&token(now + chrono::TimeDelta::minutes(4))));
+        assert!(!expires_soon(&token(now + chrono::TimeDelta::minutes(6))));
+    }
+
+    #[test]
+    fn renews_a_token_whose_expiry_is_unreadable() {
+        let mut token = token(chrono::Utc::now() + chrono::TimeDelta::hours(1));
+        token.lifetime.expires = "tomorrow".to_string();
+        assert!(expires_soon(&token));
+    }
