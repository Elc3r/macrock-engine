 use std::sync::Arc;
 
+use tokio::sync::Mutex;
 use xodus::models::secrets::LegacyToken;
 use xodus::tokens::TokenManager;
+use xodus::tokens::device::DeviceError;
+
+/// Held while the device's token is checked and renewed, so that requests arriving together
+/// renew it once.
+static DEVICE_TOKEN_RENEWAL: Mutex<()> = Mutex::const_new(());
 
 pub struct SimpleContext {
     pub client: reqwest::Client,
-    pub device_token: Option<LegacyToken>,
     tokens: Arc<TokenManager>,
 }
 
 impl SimpleContext {
-    pub fn new(device_token: LegacyToken, tokens: Arc<TokenManager>) -> Self {
+    pub fn new(tokens: Arc<TokenManager>) -> Self {
         let client = reqwest::ClientBuilder::new()
             .user_agent(format!("xodus-service/{}", env!("CARGO_PKG_VERSION")))
             .connection_verbose(true)
             .build()
             .unwrap();
 
-        Self {
-            client,
-            device_token: Some(device_token),
-            tokens,
-        }
+        Self { client, tokens }
     }
 
     pub fn tokens(&self) -> &Arc<TokenManager> {
         &self.tokens
     }
+
+    /// The device's STS token, renewed first when it is about to expire: a service can run for
+    /// longer than the token lasts.
+    pub async fn device_token(&self) -> Result<LegacyToken, DeviceError> {
+        let _renewal = DEVICE_TOKEN_RENEWAL.lock().await;
+        xodus::tokens::device::ensure_device_credentials(&self.client, &self.tokens).await
+    }
