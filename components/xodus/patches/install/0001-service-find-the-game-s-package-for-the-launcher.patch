+++ b/crates/xodus-service/src/package.rs
@@ -0,0 +1,178 @@
+//! The package Microsoft serves now for a game: the store's catalog names it, and the Xbox
+//! package service describes it to the signed-in user.
+
+use xodus::XBOX_LIVE_PACKAGES_PC;
+use xodus::api::displaycatalog::find_products_by_id;
+use xodus::models::displaycatalog::DisplayCatalogProductsResponse;
+use xodus::models::packagespc::{PackageDetails, PackageResponse};
+use xodus::proto::xodus::failure::Reason;
+use xodus::proto::xodus::{Failure, GamePackage, Package, PackageResult, package_result};
+
+use crate::account::{failure, xbox_token};
+use crate::simple_context::SimpleContext;
+
+/// The relying party of the Xbox token the package service takes.
+const XBOX_UPDATE: &str = "http://update.xboxlive.com";
+
+/// The game's package as Microsoft serves it now, without downloading it.
+pub async fn package(context: &SimpleContext, request: Package) -> PackageResult {
+    let outcome = match find(context, &request).await {
+        Ok(details) => {
+            let package = summary(&details);
+            tracing::info!(
+                "The game's package is version {}, {} bytes",
+                package.version,
+                package.size
+            );
+            package_result::Outcome::Package(package)
+        }
+        Err(failure) => package_result::Outcome::Failure(failure),
+    };
+    PackageResult {
+        outcome: Some(outcome),
+    }
+}
+
+/// The package's details, which the package service gives with an Xbox token of the user.
+async fn find(context: &SimpleContext, request: &Package) -> Result<PackageDetails, Failure> {
+    let unavailable = |err: &dyn std::fmt::Display| {
+        tracing::warn!("The game's package was not found: {err}");
+        failure(Reason::Unavailable)
+    };
+    let catalog = find_products_by_id(
+        &context.client,
+        request.product_id.clone(),
+        request.market.clone(),
+        vec!["en".to_string(), "neutral".to_string()],
+    )
+    .await
+    .map_err(|err| unavailable(&err))?;
+    let content_id =
+        desktop_content_id(&catalog).ok_or_else(|| unavailable(&"no package for Windows"))?;
+    let xsts = xbox_token(context, XBOX_UPDATE).await?;
+    let user_hash = xsts
+        .user_hash()
+        .ok_or_else(|| unavailable(&"no user hash in the Xbox token"))?;
+    let response = context
+        .client
+        .get(format!(
+            "{XBOX_LIVE_PACKAGES_PC}/GetBasePackage/{content_id}"
+        ))
+        .header("x-xbl-contract-version", "3")
+        .header(
+            "Authorization",
+            format!("XBL3.0 x={user_hash};{}", xsts.token),
+        )
+        .send()
+        .await
+        .and_then(reqwest::Response::error_for_status)
+        .map_err(|err| unavailable(&err))?;
+    match response
+        .json::<PackageResponse>()
+        .await
+        .map_err(|err| unavailable(&err))?
+    {
+        PackageResponse::Found(details) => Ok(details),
+        PackageResponse::NotFound { .. } => Err(unavailable(&"the package service has none")),
+    }
+}
+
+/// The content ID of the catalog's package for Windows desktops.
+fn desktop_content_id(catalog: &DisplayCatalogProductsResponse) -> Option<&str> {
+    catalog
+        .product
+        .display_sku_availabilities
+        .iter()
+        .flat_map(|availability| &availability.sku.properties.packages)
+        .find(|package| {
+            package
+                .platform_dependencies
+                .iter()
+                .any(|dependency| dependency.platform_name == "Windows.Desktop")
+        })
+        .and_then(|package| package.content_id.as_deref())
+}
+
+/// The game's version, and the size of the package to download. The service gives the version
+/// followed by the content's identifier (`1.26.5203.0.4650c7c5-…`); patches from earlier
+/// versions (`.xsp`) come with the package and are not downloaded.
+fn summary(details: &PackageDetails) -> GamePackage {
+    GamePackage {
+        version: details
+            .version
+            .split('.')
+            .take(4)
+            .collect::<Vec<_>>()
+            .join("."),
+        size: details
+            .package_files
+            .iter()
+            .filter(|file| file.file_name.ends_with(".msixvc"))
+            .map(|file| u64::try_from(file.file_size).unwrap_or_default())
+            .sum(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn takes_the_package_for_windows_desktops() {
+        let catalog: DisplayCatalogProductsResponse = serde_json::from_str(
+            r#"{"Product": {"DisplaySkuAvailabilities": [{"Availabilities": [], "Sku": {
+                "Properties": {"Packages": [
+                    {"ContentId": "console", "PlatformDependencies": [{"PlatformName": "Windows.Xbox"}]},
+                    {"ContentId": "desktop", "PlatformDependencies": [{"PlatformName": "Windows.Desktop"}]}
+                ]}}}]}}"#,
+        )
+        .unwrap();
+        assert_eq!(desktop_content_id(&catalog), Some("desktop"));
+    }
+
+    #[test]
+    fn has_no_package_without_one_for_windows_desktops() {
+        let catalog: DisplayCatalogProductsResponse = serde_json::from_str(
+            r#"{"Product": {"DisplaySkuAvailabilities": [{"Availabilities": [], "Sku": {
+                "Properties": {"Packages": [
+                    {"ContentId": "console", "PlatformDependencies": [{"PlatformName": "Windows.Xbox"}]}
+                ]}}}]}}"#,
+        )
+        .unwrap();
+        assert_eq!(desktop_content_id(&catalog), None);
+    }
+
+    #[test]
+    fn sizes_the_download_by_its_package_files() {
+        let file = |name: &str, size: i64| {
+            format!(
+                r#"{{"ContentId": "c", "VersionId": "v", "FileName": "{name}", "FileSize": {size},
+                "FileHash": "", "KeyBlob": "", "CdnRootPaths": [], "BackgroundCdnRootPaths": [],
+                "RelativeUrl": "/{name}", "UpdateType": 0, "LicenseUsageType": 0,
+                "ModifiedDate": "2026-10-01T00:00:00Z"}}"#
+            )
+        };
+        let details: PackageDetails = serde_json::from_str(&format!(
+            r#"{{"PackageFound": true, "ContentId": "c", "VersionId": "v",
+            "Version": "1.26.5203.0.4650c7c5-9163-48e9-9e89-6a5584d9833f",
+            "UpdatePredownload": false,
+            "AvailabilityDate": "2026-10-01T00:00:00Z", "PackageFiles": [{}, {}]}}"#,
+            file(
+                "Microsoft.MinecraftUWP_1.26.5203.0_x64__8wekyb3d8bbwe.msixvc",
+                2_069_975_040
+            ),
+            file(
+                "update-1.26.5101.0.d8c5d0b8-98a0-4965-9be6-8650afed6611.xsp",
+                7_328
+            )
+        ))
+        .unwrap();
+        assert_eq!(
+            summary(&details),
+            GamePackage {
+                version: "1.26.5203.0".to_string(),
+                size: 2_069_975_040,
+            }
+        );
+    }
+}
