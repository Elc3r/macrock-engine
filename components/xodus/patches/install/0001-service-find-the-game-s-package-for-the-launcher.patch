+// LAUNCHER_PACKAGE: the package Microsoft serves now for a game, found without downloading it.
+message Package {
+    // The game's Store ID, such as 9NBLGGH2JHXJ.
+    string product_id = 1;
+    // The market whose catalog names the package, a region such as US.
+    string market = 2;
+}
+
+// The response to LAUNCHER_PACKAGE.
+message PackageResult {
+    oneof outcome {
+        GamePackage package = 1;
+        Failure failure = 2;
+    }
+}
+
+message GamePackage {
+    // The game's version, such as 1.26.5203.0.
+    string version = 1;
+    // The size of the download, in bytes.
+    uint64 size = 2;
+}
+
 // Why a request of the launcher failed.
 message Failure {
     enum Reason {
@@ -99,6 +122,8 @@ message Failure {
         REASON_KEYCHAIN = 4;
         // No user is signed in.
         REASON_NOT_SIGNED_IN = 5;
+        // The user does not own the game.
+        REASON_NOT_OWNED = 6;
     }
     Reason reason = 1;
     // For REASON_REFUSED, Microsoft's status (an HRESULT such as 0x80048821) when it gave one.
