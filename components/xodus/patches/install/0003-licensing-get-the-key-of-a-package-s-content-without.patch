diff --git a/crates/xodus/src/licensing/key.rs b/crates/xodus/src/licensing/key.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0ec01fac2ac0edb556b13782dc95323ee7135926
--- /dev/null
+++ b/crates/xodus/src/licensing/key.rs
@@ -0,0 +1,63 @@
+//! The key that decrypts a package's content, from the content's license for the signed-in
+//! user. The license wraps the key with the device's key, which the device license holds.
+
+use crate::licensing::content::{LicenseContentError, get_license_content};
+use crate::licensing::game::{GameLicenseError, licensing_tokens};
+use crate::licensing::splicense::{ContentKey, SPLicense};
+use crate::tokens::TokenManager;
+
+#[derive(Debug, thiserror::Error)]
+pub enum ContentKeyError {
+    #[error("tokens: {0}")]
+    Tokens(String),
+    /// The user does not own the content.
+    #[error("not entitled to this content: {0}")]
+    NotEntitled(String),
+    #[error("request error: {0}")]
+    Request(#[from] reqwest::Error),
+    #[error("unreadable license: {0}")]
+    Unreadable(String),
+}
+
+/// The key of the content `content_id`, a package's content ID, licensed to the signed-in user.
+pub async fn content_key(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+    content_id: String,
+    market: String,
+) -> Result<ContentKey, ContentKeyError> {
+    let (device_token, user_token, puid) =
+        licensing_tokens(client, tokens)
+            .await
+            .map_err(|err| match err {
+                GameLicenseError::Request(err) => ContentKeyError::Request(err),
+                err => ContentKeyError::Tokens(err.to_string()),
+            })?;
+    let (_content, license) =
+        get_license_content(client, device_token, user_token, puid, content_id, market)
+            .await
+            .map_err(|err| match err {
+                LicenseContentError::NotEntitled { description } => {
+                    ContentKeyError::NotEntitled(description)
+                }
+                LicenseContentError::Request(err) => ContentKeyError::Request(err),
+                LicenseContentError::Unreadable(reason) => ContentKeyError::Unreadable(reason),
+            })?;
+    let unreadable = |what: &str| ContentKeyError::Unreadable(what.to_owned());
+    let content =
+        SPLicense::parse_base64(&license.splicense_block).map_err(|_| unreadable("the license"))?;
+    let device = tokens
+        .get_device_license()
+        .map_err(|_| unreadable("no device license"))?;
+    let device_key = SPLicense::parse_base64(&device.splicense)
+        .map_err(|_| unreadable("the device license"))?
+        .encrypted_device_key
+        .ok_or_else(|| unreadable("no device key"))?
+        .derive_device_key();
+    let mut keys = content.content_keys.into_values();
+    let (Some(key), None) = (keys.next(), keys.next()) else {
+        return Err(unreadable("not one key"));
+    };
+    key.unpack(&device_key)
+        .map_err(|_| unreadable("a key the device's key does not open"))
+}
