+
+    use super::*;
+
+    /// A package with one page of user data and `drive_pages` pages of drive data, its hash tree
+    /// and its header's top hash, as the XVD format lays them out.
+    fn package(drive_pages: u32) -> Vec<u8> {
+        let mut header = vec![0u8; PAGE];
+        header[0x200..0x208].copy_from_slice(b"msft-xvd");
+        header[0x208..0x20C].copy_from_slice(&0x41u32.to_le_bytes());
+        header[0x20C..0x210].copy_from_slice(&3u32.to_le_bytes());
+        // Created on 2026-10-01, as a FILETIME.
+        header[0x210..0x218].copy_from_slice(&134_037_216_000_000_000u64.to_le_bytes());
+        header[0x218..0x220].copy_from_slice(&(u64::from(drive_pages) * PAGE as u64).to_le_bytes());
+        header[0x284..0x288].copy_from_slice(&1u32.to_le_bytes());
+        header[0x28C..0x290].copy_from_slice(&(PAGE as u32).to_le_bytes());
+        header[0x470] = 1;
+        let layout = XvdHeader::try_from_slice(&header).unwrap().layout();
+        let data = layout.user_data.start.0 as usize;
+        let end = (layout.drive_data.start.0 + drive_pages) as usize;
+        let mut file = vec![0u8; end * PAGE];
+        let mut seed = 0x9E37_79B9_7F4A_7C15u64;
+        for byte in &mut file[data * PAGE..] {
+            seed ^= seed << 13;
+            seed ^= seed >> 7;
+            seed ^= seed << 17;
+            *byte = seed as u8;
+        }
+        let tree = layout.hash_tree.start.0 as usize;
+        let mut covered = data..end;
+        for level in levels(&layout) {
+            let first = tree + level.start as usize;
+            for (nth, page) in covered.clone().enumerate() {
+                let digest = Sha256::digest(&file[page * PAGE..(page + 1) * PAGE]);
+                let at = (first + nth / ENTRIES as usize) * PAGE + nth % ENTRIES as usize * 24;
+                file[at..at + 24].copy_from_slice(&digest[..24]);
+            }
+            covered = first..tree + level.end as usize;
+        }
+        let top = Sha256::digest(&file[covered.start * PAGE..(covered.start + 1) * PAGE]);
+        header[0x240..0x260].copy_from_slice(&top);
+        file[..PAGE].copy_from_slice(&header);
+        file
+    }
+
+    #[derive(Clone, Copy)]
+    enum Serve {
+        Range,
+        /// The whole package, whatever the range asked.
+        Whole,
+        /// The answer stops at this byte of the package.
+        CutAt(usize),
+        /// The byte at this offset of the package arrives changed.
+        Corrupt(usize),
+        Fail,
+    }
+
+    /// A CDN on a local port. For the nth request and the byte it asks to start from,
+    /// `behaviour` tells what it serves; it returns the URL and the starts asked.
+    async fn cdn(
+        package: Arc<Vec<u8>>,
+        behaviour: impl Fn(usize) -> Serve + Send + Sync + 'static,
+    ) -> (String, Arc<Mutex<Vec<u64>>>) {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("http://{}/package.msixvc", listener.local_addr().unwrap());
+        let starts = Arc::new(Mutex::new(Vec::new()));
+        let requests = Arc::new(AtomicUsize::new(0));
+        let behaviour = Arc::new(behaviour);
+        let recorded = starts.clone();
+        tokio::spawn(async move {
+            loop {
+                let (mut socket, _) = listener.accept().await.unwrap();
+                let nth = requests.fetch_add(1, Ordering::SeqCst);
+                let package = package.clone();
+                let behaviour = behaviour.clone();
+                let recorded = recorded.clone();
+                tokio::spawn(async move {
+                    let (reader, mut writer) = socket.split();
+                    let mut reader = tokio::io::BufReader::new(reader);
+                    let mut start = 0;
+                    loop {
+                        let mut line = String::new();
+                        reader.read_line(&mut line).await.unwrap();
+                        if line == "\r\n" || line.is_empty() {
+                            break;
+                        }
+                        if let Some(range) = line.to_ascii_lowercase().strip_prefix("range: bytes=")
+                        {
+                            start = range.trim().trim_end_matches('-').parse().unwrap();
+                        }
+                    }
+                    recorded.lock().await.push(start as u64);
+                    let size = package.len();
+                    let (status, from, mut body) = match behaviour(nth) {
+                        Serve::Fail => {
+                            let _ = writer
+                                .write_all(b"HTTP/1.1 503 Unavailable\r\nContent-Length: 0\r\n\r\n")
+                                .await;
+                            return;
+                        }
+                        Serve::Whole => ("200 OK", 0, package[..].to_vec()),
+                        _ => ("206 Partial Content", start, package[start..].to_vec()),
+                    };
+                    let length = body.len();
+                    match behaviour(nth) {
+                        Serve::CutAt(at) => body.truncate(at.saturating_sub(from)),
+                        Serve::Corrupt(at) if at >= from => body[at - from] ^= 0xFF,
+                        _ => {}
+                    }
+                    let head = format!(
+                        "HTTP/1.1 {status}\r\nContent-Length: {length}\r\nContent-Range: bytes {from}-{}/{size}\r\nConnection: close\r\n\r\n",
+                        size - 1
+                    );
+                    let _ = writer.write_all(head.as_bytes()).await;
+                    let _ = writer.write_all(&body).await;
+                });
+            }
+        });
+        (url, starts)
+    }
+
+    fn downloader() -> Downloader {
+        Downloader::with_retry_delay(Duration::ZERO).unwrap()
+    }
+
+    #[tokio::test]
+    async fn downloads_a_package_checking_every_page() {
+        let package = Arc::new(package(400));
+        let (url, _) = cdn(package.clone(), |_| Serve::Range).await;
+        let directory = tempfile::tempdir().unwrap();
+        let part = directory.path().join("package.part");
+        let mut reported = 0;
+
+        downloader()
+            .download(&[url], package.len() as u64, &part, |have| reported = have)
+            .await
+            .unwrap();
+
+        assert_eq!(std::fs::read(&part).unwrap(), *package);
+        assert_eq!(reported, package.len() as u64);
+    }
+
+    #[tokio::test]
+    async fn goes_on_from_the_pages_already_downloaded() {
+        let package = Arc::new(package(400));
+        let (url, starts) = cdn(package.clone(), |_| Serve::Range).await;
+        let directory = tempfile::tempdir().unwrap();
+        let part = directory.path().join("package.part");
+        std::fs::write(&part, &package[..20 * PAGE + 100]).unwrap();
+
+        downloader()
+            .download(&[url], package.len() as u64, &part, |_| {})
+            .await
+            .unwrap();
+
+        assert_eq!(*starts.lock().await, [20 * PAGE as u64]);
+        assert_eq!(std::fs::read(&part).unwrap(), *package);
+    }
+
+    #[tokio::test]
+    async fn downloads_again_the_pages_that_do_not_check() {
+        let package = Arc::new(package(400));
+        let (url, starts) = cdn(package.clone(), |_| Serve::Range).await;
+        let directory = tempfile::tempdir().unwrap();
+        let part = directory.path().join("package.part");
+        let mut damaged = package[..300 * PAGE].to_vec();
+        damaged[150 * PAGE + 7] ^= 1;
+        std::fs::write(&part, &damaged).unwrap();
+
+        downloader()
+            .download(&[url], package.len() as u64, &part, |_| {})
+            .await
+            .unwrap();
+
+        assert_eq!(*starts.lock().await, [150 * PAGE as u64]);
+        assert_eq!(std::fs::read(&part).unwrap(), *package);
+    }
+
+    #[tokio::test]
+    async fn takes_the_package_from_another_cdn_when_one_damages_it() {
+        let package = Arc::new(package(400));
+        let (damaging, _) = cdn(package.clone(), |_| Serve::Corrupt(200 * PAGE)).await;
+        let (sound, starts) = cdn(package.clone(), |_| Serve::Range).await;
+        let directory = tempfile::tempdir().unwrap();
+        let part = directory.path().join("package.part");
+
+        downloader()
+            .download(&[damaging, sound], package.len() as u64, &part, |_| {})
+            .await
+            .unwrap();
+
+        assert_eq!(*starts.lock().await, [200 * PAGE as u64]);
+        assert_eq!(std::fs::read(&part).unwrap(), *package);
+    }
+
+    #[tokio::test]
+    async fn gives_up_on_a_package_that_keeps_arriving_damaged() {
+        let package = Arc::new(package(400));
+        let (url, _) = cdn(package.clone(), |_| Serve::Corrupt(200 * PAGE)).await;
+        let directory = tempfile::tempdir().unwrap();
+        let part = directory.path().join("package.part");
+
+        let result = downloader()
+            .download(&[url], package.len() as u64, &part, |_| {})
+            .await;
+
+        assert!(matches!(result, Err(DownloadError::Damaged)));
+        assert_eq!(std::fs::metadata(&part).unwrap().len(), 200 * PAGE as u64);
+    }
+
+    #[tokio::test]
+    async fn goes_on_after_a_cdn_cuts_the_download() {
+        let package = Arc::new(package(400));
+        let (url, starts) = cdn(package.clone(), |nth| match nth {
+            0 => Serve::CutAt(100 * PAGE + 10),
+            _ => Serve::Range,
+        })
+        .await;
+        let directory = tempfile::tempdir().unwrap();
+        let part = directory.path().join("package.part");
+
+        downloader()
+            .download(&[url], package.len() as u64, &part, |_| {})
+            .await
+            .unwrap();
+
+        assert_eq!(*starts.lock().await, [0, 100 * PAGE as u64]);
+        assert_eq!(std::fs::read(&part).unwrap(), *package);
+    }
+
+    #[tokio::test]
+    async fn starts_again_when_a_cdn_ignores_the_range() {
+        let package = Arc::new(package(400));
+        let (url, _) = cdn(package.clone(), |_| Serve::Whole).await;
+        let directory = tempfile::tempdir().unwrap();
+        let part = directory.path().join("package.part");
+        std::fs::write(&part, &package[..20 * PAGE]).unwrap();
+
+        downloader()
+            .download(&[url], package.len() as u64, &part, |_| {})
+            .await
+            .unwrap();
+
+        assert_eq!(std::fs::read(&part).unwrap(), *package);
+    }
+
+    #[tokio::test]
+    async fn gives_up_when_no_cdn_answers() {
+        let package = Arc::new(package(400));
+        let (url, starts) = cdn(package.clone(), |_| Serve::Fail).await;
+        let directory = tempfile::tempdir().unwrap();
+        let part = directory.path().join("package.part");
+
+        let result = downloader()
+            .download(&[url], package.len() as u64, &part, |_| {})
+            .await;
+
+        assert!(matches!(result, Err(DownloadError::Unavailable)));
+        assert_eq!(starts.lock().await.len(), IDLE_ROUNDS as usize);
+    }
+
+    /// Checks the pages of a real package, or of its start, named by XODUS_TEST_PACKAGE.
+    #[test]
+    #[ignore = "needs a package in XODUS_TEST_PACKAGE"]
+    fn every_page_of_a_real_package_checks() {
+        let path = std::env::var("XODUS_TEST_PACKAGE").unwrap();
+        let package = std::fs::read(path).unwrap();
+        let mut check = PageCheck::default();
+        for page in package.as_chunks::<PAGE>().0 {
+            check.check(page).unwrap();
+        }
+        assert!(check.next > 2, "only {} pages", check.next);
+    }
+
+    #[tokio::test]
+    async fn refuses_a_download_without_room_for_it() {
+        let directory = tempfile::tempdir().unwrap();
+        let part = directory.path().join("package.part");
+
+        let result = downloader()
+            .download(&["http://127.0.0.1:9/".to_string()], 1 << 60, &part, |_| {})
+            .await;
+
+        assert!(matches!(result, Err(DownloadError::NoSpace { .. })));
+    }
+}
diff --git a/crates/xodus-service/src/extract.rs b/crates/xodus-service/src/extract.rs
new file mode 100644
index 0000000000000000000000000000000000000000..45008f2173237e61df0cf13df0383abd81db3aec
--- /dev/null
+++ b/crates/xodus-service/src/extract.rs
@@ -0,0 +1,273 @@
+//! Extracting the game from its downloaded package. The package keeps the executable encrypted on
+//! disk, for Gaming Services to decrypt as Windows loads it; Wine loads it from the disk, so it
+//! is decrypted with every other file.
+
+use std::collections::HashSet;
+use std::path::{Component, Path, PathBuf};
+
+use futures_util::StreamExt;
+use futures_util::stream::FuturesUnordered;
+use msixvc::xvd::{SegmentFile, XvdFile};
+use tokio::fs::{File, OpenOptions};
+use tokio::io::{AsyncReadExt, AsyncSeekExt, AsyncWriteExt, BufWriter};
+use xodus::licensing::splicense::ContentKey;
+
+use crate::download::free_space;
+
+/// Room left free beyond the files.
+const SPARE: u64 = 512 << 20;
+/// Files extracted at once.
+const CONCURRENT_FILES: usize = 4;
+
+#[derive(Debug, thiserror::Error)]
+pub enum ExtractError {
+    #[error("the files need {needed} bytes free, and {free} are")]
+    NoSpace { needed: u64, free: u64 },
+    /// The package's metadata or content is not what an extractable package holds.
+    #[error("the package: {0}")]
+    Unreadable(String),
+    #[error(transparent)]
+    Io(#[from] std::io::Error),
+}
+
+/// A downloaded package and the files it holds, their paths checked.
+pub struct PackageFiles {
+    path: PathBuf,
+    xvd: XvdFile,
+    files: Vec<(PathBuf, SegmentFile)>,
+}
+
+impl PackageFiles {
+    /// Reads the package's file list: its segment metadata, and the NTFS volume for what that
+    /// does not tell, such as which files the package keeps encrypted.
+    pub async fn open(path: &Path) -> Result<Self, ExtractError> {
+        let unreadable =
+            |err: Box<dyn std::error::Error>| ExtractError::Unreadable(err.to_string());
+        let mut file = File::open(path).await?;
+        let xvd = XvdFile::parse(&mut file).await.map_err(unreadable)?;
+        let mut segments = std::collections::HashMap::new();
+        let package_files = xvd
+            .parse_user_package_files(&mut file)
+            .await
+            .map_err(unreadable)?;
+        if let Some(metadata) = package_files.get("SegmentMetadata.bin") {
+            segments = xvd
+                .parse_segment_metadata(&mut file, metadata)
+                .await
+                .map_err(unreadable)?;
+        }
+        let has_segments = !segments.is_empty();
+        segments.extend(
+            xvd.parse_ntfs_segment_metadata(&mut file, has_segments)
+                .await
+                .map_err(unreadable)?,
+        );
+        let files = checked_paths(segments)?;
+        Ok(Self {
+            path: path.to_owned(),
+            xvd,
+            files,
+        })
+    }
+
+    /// The ID of the package's content, whose license holds the key that decrypts it.
+    pub fn content_id(&self) -> uuid::Uuid {
+        self.xvd.content_id()
+    }
+
+    /// The size of the files, in bytes.
+    pub fn size(&self) -> u64 {
+        self.files.iter().map(|(_, file)| file.length).sum()
+    }
+
+    /// Extracts every file into `destination`, which must not exist, and decrypts them with
+    /// `key`. `progress` gets the bytes extracted.
+    pub async fn extract(
+        &self,
+        key: &ContentKey,
+        destination: &Path,
+        mut progress: impl FnMut(u64),
+    ) -> Result<(), ExtractError> {
+        let needed = self.size() + SPARE;
+        let free = free_space(destination)?;
+        if free < needed {
+            return Err(ExtractError::NoSpace { needed, free });
+        }
+        tokio::fs::create_dir(destination).await?;
+        let mut files = self.files.iter();
+        let mut extracting = FuturesUnordered::new();
+        let mut extracted = 0;
+        loop {
+            while extracting.len() < CONCURRENT_FILES
+                && let Some((relative, file)) = files.next()
+            {
+                extracting.push(self.extract_file(relative, file, key, destination));
+            }
+            let Some(length) = extracting.next().await else {
+                return Ok(());
+            };
+            extracted += length?;
+            progress(extracted);
+        }
+    }
+
+    async fn extract_file(
+        &self,
+        relative: &Path,
+        file: &SegmentFile,
+        key: &ContentKey,
+        destination: &Path,
+    ) -> Result<u64, ExtractError> {
+        let target = destination.join(relative);
+        if let Some(parent) = target.parent() {
+            tokio::fs::create_dir_all(parent).await?;
+        }
+        let output = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&target)
+            .await?;
+        let mut output = BufWriter::with_capacity(1 << 20, output);
+        let mut package = File::open(&self.path).await?;
+        let unreadable = |err: Box<dyn std::error::Error>| {
+            ExtractError::Unreadable(format!("{}: {err}", relative.display()))
+        };
+        if file.keep_encrypted {
+            // Decrypts what the package keeps encrypted on disk too, reading from the file's start.
+            package.seek(std::io::SeekFrom::Start(file.offset)).await?;
+            self.xvd
+                .mount_mem_fd(&mut package, &mut output, file, **key, |_, _| {})
+                .await
+                .map_err(unreadable)?;
+        } else {
+            self.xvd
+                .extract_file(&mut package, &mut output, file, **key, |_, _| {})
+                .await
+                .map_err(unreadable)?;
+        }
+        output.flush().await?;
+        let output = output.into_inner();
+        output.sync_all().await?;
+        if output.metadata().await?.len() != file.length {
+            return Err(ExtractError::Unreadable(format!(
+                "{} has another size",
+                relative.display()
+            )));
+        }
+        if file.keep_encrypted && is_program(relative) {
+            let mut signature = [0; 2];
+            File::open(&target)
+                .await?
+                .read_exact(&mut signature)
+                .await?;
+            // A program that does not start like one was decrypted with another key.
+            if &signature != b"MZ" {
+                return Err(ExtractError::Unreadable(format!(
+                    "{} is not a program once decrypted",
+                    relative.display()
+                )));
+            }
+        }
+        Ok(file.length)
+    }
+}
+
+/// The package's files with relative paths that stay inside the destination, and that differ
+/// other than by case: neither NTFS nor macOS's default volumes tell such paths apart.
+fn checked_paths(
+    segments: std::collections::HashMap<String, SegmentFile>,
+) -> Result<Vec<(PathBuf, SegmentFile)>, ExtractError> {
+    let mut seen = HashSet::new();
+    let mut files = Vec::with_capacity(segments.len());
+    for (name, file) in segments {
+        let relative = relative_path(&name)
+            .ok_or_else(|| ExtractError::Unreadable(format!("an unsafe path: {name:?}")))?;
+        if !seen.insert(relative.to_string_lossy().to_lowercase()) {
+            return Err(ExtractError::Unreadable(format!("two files at {name:?}")));
+        }
+        files.push((relative, file));
+    }
+    if files.is_empty() {
+        return Err(ExtractError::Unreadable("no files".to_string()));
+    }
+    Ok(files)
+}
+
+/// A package's Windows path as a relative path, or None when it would leave the destination.
+fn relative_path(name: &str) -> Option<PathBuf> {
+    let name = name.replace('\\', "/");
+    let path = Path::new(&name);
+    let safe = !name.is_empty()
+        && !name.contains([':', '\0'])
+        && path
+            .components()
+            .all(|component| matches!(component, Component::Normal(_)));
+    safe.then(|| path.to_path_buf())
+}
+
+fn is_program(path: &Path) -> bool {
+    path.extension().is_some_and(|extension| {
+        extension.eq_ignore_ascii_case("exe") || extension.eq_ignore_ascii_case("dll")
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn keeps_paths_inside_the_destination() {
+        assert_eq!(
+            relative_path(r"data\resource_packs\vanilla\manifest.json"),
+            Some(PathBuf::from("data/resource_packs/vanilla/manifest.json"))
+        );
+        for name in [
+            "",
+            r"..\outside.dll",
+            r"data\..\..\outside.dll",
+            "/etc/hosts",
+            r"C:\Windows\system32\kernel32.dll",
+            "data\0name",
+        ] {
+            assert_eq!(relative_path(name), None, "{name:?}");
+        }
+    }
+
+    #[test]
+    fn refuses_paths_that_differ_only_by_case() {
+        let file = || SegmentFile {
+            offset: 0,
+            length: 1,
+            data_hashs: Vec::new(),
+            keep_encrypted: false,
+        };
+        let segments = [
+            ("Data/Gui.json".to_string(), file()),
+            ("data/gui.json".to_string(), file()),
+        ];
+        assert!(matches!(
+            checked_paths(segments.into_iter().collect()),
+            Err(ExtractError::Unreadable(_))
+        ));
+    }
+
+    /// Lists the files of a real package, or of its start, named by XODUS_TEST_PACKAGE.
+    #[tokio::test(flavor = "multi_thread")]
+    #[ignore = "needs a package in XODUS_TEST_PACKAGE"]
+    async fn lists_the_files_of_a_real_package() {
+        let path = std::env::var("XODUS_TEST_PACKAGE").unwrap();
+        let package = PackageFiles::open(Path::new(&path)).await.unwrap();
+        let executable = package
+            .files
+            .iter()
+            .find(|(path, _)| path == Path::new("Minecraft.Windows.exe"))
+            .unwrap();
+        assert!(executable.1.keep_encrypted);
+        println!(
+            "{} files, {} bytes, content {}",
+            package.files.len(),
+            package.size(),
+            package.content_id()
+        );
+    }
+}
diff --git a/crates/xodus-service/src/install.rs b/crates/xodus-service/src/install.rs
new file mode 100644
index 0000000000000000000000000000000000000000..62c0db93ce906691f1cc530354fa3f143b755777
--- /dev/null
+++ b/crates/xodus-service/src/install.rs
@@ -0,0 +1,222 @@
+//! Installing the game for the launcher: the package Microsoft serves now, downloaded into the
+//! launcher's staging folder, and the game extracted from it beside it. The key of the package's
+//! content comes first, so that a user who does not own the game downloads nothing.
+
+use std::path::Path;
+
+use tokio::sync::watch;
+use xodus::licensing::key::{ContentKeyError, content_key};
+use xodus::proto::xodus::failure::Reason;
+use xodus::proto::xodus::install_progress::Phase;
+use xodus::proto::xodus::{Failure, GameInstalled, Install, InstallProgress, install_update};
+
+use crate::account::failure;
+use crate::download::{DownloadError, Downloader};
+use crate::extract::{ExtractError, PackageFiles};
+use crate::package::find;
+use crate::simple_context::SimpleContext;
+
+/// The end of a download's name, which starts with the package's version.
+const DOWNLOAD: &str = ".msixvc.part";
+
+/// Installs the game into the staging folder of `request`, updating `progress` as it goes.
+pub async fn install(
+    context: &SimpleContext,
+    request: Install,
+    progress: watch::Sender<InstallProgress>,
+) -> install_update::Update {
+    match run(context, &request, &progress).await {
+        Ok(version) => {
+            tracing::info!("Installed the game, version {version}");
+            install_update::Update::Installed(GameInstalled { version })
+        }
+        Err(failure) => install_update::Update::Failure(failure),
+    }
+}
+
+async fn run(
+    context: &SimpleContext,
+    request: &Install,
+    progress: &watch::Sender<InstallProgress>,
+) -> Result<String, Failure> {
+    let package = find(context, &request.product_id, &request.market).await?;
+    let key = content_key(
+        &context.client,
+        context.tokens(),
+        package.content_id.clone(),
+        request.market.clone(),
+    )
+    .await
+    .map_err(|err| key_failure(context, err))?;
+
+    let staging = Path::new(&request.staging);
+    let download = staging.join(format!("{}{DOWNLOAD}", package.version));
+    remove_other_downloads(staging, &download)
+        .await
+        .map_err(disk)?;
+    tracing::info!("Downloading the package of version {}", package.version);
+    let downloader = Downloader::new().map_err(|err| {
+        tracing::error!("No client for the CDNs: {err}");
+        failure(Reason::Unavailable)
+    })?;
+    downloader
+        .download(&package.urls, package.size, &download, |done| {
+            report(progress, Phase::Downloading, done, package.size);
+        })
+        .await
+        .map_err(download_failure)?;
+
+    let files = PackageFiles::open(&download)
+        .await
+        .map_err(extract_failure)?;
+    if uuid::Uuid::parse_str(&package.content_id).ok() != Some(files.content_id()) {
+        tracing::warn!("The package's content is not the one the catalog names");
+        return Err(failure(Reason::UnreadablePackage));
+    }
+    let game = staging.join("game");
+    remove_game(&game).await.map_err(disk)?;
+    let total = files.size();
+    tracing::info!("Extracting the game, {total} bytes");
+    let extracted = files
+        .extract(&key, &game, |done| {
+            report(progress, Phase::Extracting, done, total);
+        })
+        .await;
+    if let Err(err) = extracted {
+        // A new install extracts every file again: those extracted so far only take room.
+        if let Err(err) = remove_game(&game).await {
+            tracing::warn!("The files extracted so far were not removed: {err}");
+        }
+        return Err(extract_failure(err));
+    }
+    if let Err(err) = tokio::fs::remove_file(&download).await {
+        tracing::warn!("The package was not removed: {err}");
+    }
+    Ok(package.version)
+}
+
+/// Updates the progress at each thousandth of a phase.
+fn report(progress: &watch::Sender<InstallProgress>, phase: Phase, done: u64, total: u64) {
+    let thousandths = |done: u64| u128::from(done) * 1000 / u128::from(total.max(1));
+    progress.send_if_modified(|last| {
+        let changed = last.phase() != phase || thousandths(last.done) != thousandths(done);
+        if changed {
+            *last = InstallProgress {
+                phase: phase.into(),
+                done,
+                total,
+            };
+        }
+        changed
+    });
+}
+
+/// Removes the downloads of other versions: Microsoft serves only the current one, so they would
+/// never complete.
+async fn remove_other_downloads(staging: &Path, download: &Path) -> std::io::Result<()> {
+    let mut entries = tokio::fs::read_dir(staging).await?;
+    while let Some(entry) = entries.next_entry().await? {
+        let path = entry.path();
+        if path != download && entry.file_name().to_string_lossy().ends_with(DOWNLOAD) {
+            tracing::info!("Removing the download of another version");
+            tokio::fs::remove_file(&path).await?;
+        }
+    }
+    Ok(())
+}
+
+async fn remove_game(game: &Path) -> std::io::Result<()> {
+    match tokio::fs::remove_dir_all(game).await {
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(()),
+        removed => removed,
+    }
+}
+
+fn key_failure(context: &SimpleContext, err: ContentKeyError) -> Failure {
+    tracing::warn!("No key for the package's content: {err}");
+    failure(match err {
+        ContentKeyError::NotEntitled(_) => Reason::NotOwned,
+        ContentKeyError::Tokens(_) if context.tokens().user_token_refused() => Reason::Refused,
+        _ => Reason::Unavailable,
+    })
+}
+
+fn download_failure(err: DownloadError) -> Failure {
+    tracing::warn!("The package was not downloaded: {err}");
+    match err {
+        DownloadError::NoSpace { needed, .. } => no_space(needed),
+        DownloadError::Unavailable => failure(Reason::Unavailable),
+        DownloadError::Damaged => failure(Reason::Damaged),
+        DownloadError::Io(_) => failure(Reason::Disk),
+    }
+}
+
+fn extract_failure(err: ExtractError) -> Failure {
+    tracing::warn!("The game was not extracted: {err}");
+    match err {
+        ExtractError::NoSpace { needed, .. } => no_space(needed),
+        ExtractError::Unreadable(_) => failure(Reason::UnreadablePackage),
+        ExtractError::Io(_) => failure(Reason::Disk),
+    }
+}
+
+fn no_space(needed: u64) -> Failure {
+    Failure {
+        reason: Reason::NoSpace.into(),
+        bytes_needed: needed,
+        ..Failure::default()
+    }
+}
+
+fn disk(err: std::io::Error) -> Failure {
+    tracing::warn!("The staging folder: {err}");
+    failure(Reason::Disk)
