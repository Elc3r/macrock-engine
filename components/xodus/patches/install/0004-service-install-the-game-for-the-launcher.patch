index 0000000000000000000000000000000000000000..68f5c44e8249667a2deb7006ada86d12d997598c
--- /dev/null
+++ b/crates/xodus-service/src/download.rs
@@ -0,0 +1,668 @@
+//! Downloading the game's package from Microsoft's CDNs, which serve it over plain HTTP with no
+//! hash to check it against. Every page is checked against the package's own hash tree as it
+//! arrives, which catches a damaged or cut download, and a download goes on from the last page
+//! that checked.
+
+use std::io::SeekFrom;
+use std::ops::Range;
+use std::path::Path;
+use std::time::Duration;
+
+use msixvc::models::xvd::XvdHeader;
+use msixvc::models::xvd::layout::XvdLayout;
+use msixvc_common::parse::BinaryTryParse;
+use reqwest::StatusCode;
+use reqwest::header::{CONTENT_RANGE, RANGE};
+use sha2::{Digest, Sha256};
+use tokio::fs::{File, OpenOptions};
+use tokio::io::{AsyncReadExt, AsyncSeekExt, AsyncWriteExt, BufReader, BufWriter};
+
+const PAGE: usize = 4096;
+/// A page of the hash tree holds 170 entries of 24 bytes. An entry starts with the first 20
+/// bytes of the SHA-256 of the page it covers; an encrypted page's entry ends with its XTS data
+/// unit instead of more of the hash.
+const ENTRIES: u32 = (PAGE / 24) as u32;
+const CHECKED_HASH: usize = 20;
+/// Room left free beyond the download and the files it will hold.
+const SPARE: u64 = 512 << 20;
+/// Rounds over every CDN without a page more before giving up.
+const IDLE_ROUNDS: u32 = 3;
+/// Damaged pages accepted before giving up: a CDN that keeps damaging the package.
+const DAMAGED_PAGES: u32 = 3;
+
+#[derive(Debug, thiserror::Error)]
+pub enum DownloadError {
+    #[error("the download needs {needed} bytes free, and {free} are")]
+    NoSpace { needed: u64, free: u64 },
+    #[error("no CDN gave the package")]
+    Unavailable,
+    #[error("the package kept arriving damaged")]
+    Damaged,
+    #[error(transparent)]
+    Io(#[from] std::io::Error),
+}
+
+/// Fetches packages from the CDNs: the only requests of the service over plain HTTP.
+pub struct Downloader {
+    client: reqwest::Client,
+    /// The wait before going over the CDNs again, doubled at each round without progress.
+    retry_delay: Duration,
+}
+
+impl Downloader {
+    pub fn new() -> reqwest::Result<Self> {
+        Self::with_retry_delay(Duration::from_secs(2))
+    }
+
+    fn with_retry_delay(retry_delay: Duration) -> reqwest::Result<Self> {
+        let client = reqwest::Client::builder()
+            .user_agent(format!("xodus-service/{}", env!("CARGO_PKG_VERSION")))
+            .connect_timeout(Duration::from_secs(15))
+            .read_timeout(Duration::from_secs(30))
+            .build()?;
+        Ok(Self {
+            client,
+            retry_delay,
+        })
+    }
+
+    /// Downloads the package of `size` bytes from any of `urls` into `part`, going on from the
+    /// pages `part` already holds that check. `progress` gets the bytes downloaded and checked.
+    pub async fn download(
+        &self,
+        urls: &[String],
+        size: u64,
+        part: &Path,
+        mut progress: impl FnMut(u64),
+    ) -> Result<(), DownloadError> {
+        let mut file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(part)
+            .await?;
+        let mut download = Progress::resume(&mut file, size).await?;
+        if download.have > 0 {
+            tracing::info!("Going on from byte {} of {size}", download.have);
+        }
+        progress(download.have);
+        let needed = size - download.have + size + SPARE;
+        let free = free_space(part)?;
+        if free < needed {
+            return Err(DownloadError::NoSpace { needed, free });
+        }
+        let mut file = BufWriter::with_capacity(1 << 20, file);
+        let result = self
+            .transfer(urls, size, &mut file, &mut download, &mut progress)
+            .await;
+        // The pages checked so far are kept, for the next download to go on from.
+        file.flush().await?;
+        file.get_ref().sync_all().await?;
+        result
+    }
+
+    /// Goes over the CDNs until one gives the rest of the package.
+    async fn transfer(
+        &self,
+        urls: &[String],
+        size: u64,
+        file: &mut BufWriter<File>,
+        download: &mut Progress,
+        progress: &mut impl FnMut(u64),
+    ) -> Result<(), DownloadError> {
+        let mut damaged = 0;
+        let mut idle_rounds = 0;
+        while download.have < size {
+            let before = download.have;
+            for url in urls {
+                match self.fetch(url, size, file, download, progress).await {
+                    Ok(()) => break,
+                    Err(Fetch::Damaged(page)) => {
+                        tracing::warn!("A CDN gave page {page} of the package damaged");
+                        damaged += 1;
+                        if damaged > DAMAGED_PAGES {
+                            return Err(DownloadError::Damaged);
+                        }
+                    }
+                    Err(Fetch::Failed(reason)) => {
+                        tracing::warn!("A CDN did not give the package: {reason}");
+                    }
+                    Err(Fetch::Io(err)) => return Err(err.into()),
+                }
+            }
+            if download.have == size {
+                break;
+            }
+            if download.have > before {
+                idle_rounds = 0;
+            } else {
+                idle_rounds += 1;
+                if idle_rounds == IDLE_ROUNDS {
+                    return Err(DownloadError::Unavailable);
+                }
+            }
+            tokio::time::sleep(self.retry_delay * 2u32.pow(idle_rounds)).await;
+        }
+        Ok(())
+    }
+
+    /// Asks one CDN for the rest of the package and keeps every page of its answer that checks.
+    async fn fetch(
+        &self,
+        url: &str,
+        size: u64,
+        file: &mut BufWriter<File>,
+        download: &mut Progress,
+        progress: &mut impl FnMut(u64),
+    ) -> Result<(), Fetch> {
+        let mut request = self.client.get(url);
+        if download.have > 0 {
+            request = request.header(RANGE, format!("bytes={}-", download.have));
+        }
+        let mut response = request
+            .send()
+            .await
+            .and_then(reqwest::Response::error_for_status)
+            .map_err(|err| Fetch::Failed(err.to_string()))?;
+        let start = match response.status() {
+            StatusCode::PARTIAL_CONTENT => range_start(&response)
+                .ok_or_else(|| Fetch::Failed("a partial answer without its range".to_string()))?,
+            _ => 0,
+        };
+        if start != download.have {
+            if start != 0 {
+                return Err(Fetch::Failed(format!("an answer from byte {start}")));
+            }
+            // The CDN ignored the range and sends the whole package again.
+            file.flush().await.map_err(Fetch::Io)?;
+            file.get_ref().set_len(0).await.map_err(Fetch::Io)?;
+            *download = Progress::default();
+        }
+        file.seek(SeekFrom::Start(download.have))
+            .await
+            .map_err(Fetch::Io)?;
+        let mut page = Vec::with_capacity(PAGE);
+        while let Some(chunk) = response
+            .chunk()
+            .await
+            .map_err(|err| Fetch::Failed(err.to_string()))?
+        {
+            let mut chunk = &chunk[..];
+            while !chunk.is_empty() {
+                if download.have == size {
+                    return Err(Fetch::Failed("more than the package".to_string()));
+                }
+                let take = chunk.len().min(PAGE - page.len());
+                page.extend_from_slice(&chunk[..take]);
+                chunk = &chunk[take..];
+                if page.len() == PAGE {
+                    download.check.check(&page).map_err(Fetch::Damaged)?;
+                    file.write_all(&page).await.map_err(Fetch::Io)?;
+                    download.have += PAGE as u64;
+                    progress(download.have);
+                    page.clear();
+                }
+            }
+        }
+        if download.have < size {
+            return Err(Fetch::Failed(format!("cut at byte {}", download.have)));
+        }
+        Ok(())
+    }
+}
+
+enum Fetch {
+    /// The page with this index did not check: the download goes on before it.
+    Damaged(u32),
+    Failed(String),
+    Io(std::io::Error),
+}
+
+/// What is downloaded and checked: whole pages, in their order.
+#[derive(Default)]
+struct Progress {
+    check: PageCheck,
+    have: u64,
+}
+
+impl Progress {
+    /// Checks the pages `file` already holds, and drops it from the first page that does not
+    /// check: a page cut by a stop, or damaged on the disk.
+    async fn resume(file: &mut File, size: u64) -> std::io::Result<Self> {
+        let length = file.metadata().await?.len().min(size);
+        let mut progress = Self::default();
+        file.seek(SeekFrom::Start(0)).await?;
+        let mut reader = BufReader::with_capacity(1 << 20, &mut *file);
+        let mut page = [0; PAGE];
+        while progress.have + PAGE as u64 <= length {
+            reader.read_exact(&mut page).await?;
+            if progress.check.check(&page).is_err() {
+                break;
+            }
+            progress.have += PAGE as u64;
+        }
+        file.set_len(progress.have).await?;
+        Ok(progress)
+    }
+}
+
+/// Checks the pages of a package in their order against its hash tree. The header holds the
+/// hash of the tree's top page, each level of the tree checks the one below, and the lowest
+/// checks every page after the tree. The header itself is taken as it comes: Microsoft signs it
+/// with a key nobody else has.
+#[derive(Default)]
+struct PageCheck {
+    next: u32,
+    tree: Option<Tree>,
+}
+
+struct Tree {
+    top_hash: [u8; 32],
+    /// The tree's first page in the package.
+    start: u32,
+    /// The pages of each level, from the tree's start: level 0 first, the top last.
+    levels: Vec<Range<u32>>,
+    /// The tree's pages checked so far, in their order in the package (the top first).
+    pages: Vec<[u8; PAGE]>,
+    /// The first page the tree covers, and the package's end.
+    covered: Range<u32>,
+}
+
+impl PageCheck {
+    /// Checks the next page; on failure, the check stays where it was.
+    fn check(&mut self, page: &[u8]) -> Result<(), u32> {
+        let index = self.next;
+        match &mut self.tree {
+            None => self.tree = Some(Tree::from_header(page).ok_or(index)?),
+            Some(tree) => tree.check(index, page).ok_or(index)?,
+        }
+        self.next += 1;
+        Ok(())
+    }
+}
+
+impl Tree {
+    fn from_header(page: &[u8]) -> Option<Self> {
+        let header = XvdHeader::try_from_slice(page).ok()?;
+        // The layout asserts that the tree covers a page at least.
+        if header.number_of_hashed_pages().0 == 0 {
+            return None;
+        }
+        let layout = header.layout();
+        Some(Self {
+            top_hash: header.top_hash_block_hash,
+            start: layout.hash_tree.start.0,
+            levels: levels(&layout),
+            pages: Vec::new(),
+            covered: layout.user_data.start.0
+                ..layout.drive_data.start.0 + layout.drive_data.len.to_page_count().0,
+        })
+    }
+
+    fn check(&mut self, index: u32, page: &[u8]) -> Option<()> {
+        let digest = Sha256::digest(page);
+        if index < self.start {
+            return Some(());
+        }
+        if index < self.covered.start {
+            let position = index - self.start;
+            let level = self
+                .levels
+                .iter()
+                .position(|level| level.contains(&position))?;
+            let expected = match self.levels.get(level + 1) {
+                Some(parent) => self.entry(parent, position - self.levels[level].start)?,
+                None => &self.top_hash[..],
+            };
+            if expected[..CHECKED_HASH] != digest[..CHECKED_HASH] {
+                return None;
+            }
+            self.pages.push(page.try_into().ok()?);
+            return Some(());
+        }
+        if !self.covered.contains(&index) {
+            return None;
+        }
+        let expected = self.entry(&self.levels[0], index - self.covered.start)?;
+        (expected[..CHECKED_HASH] == digest[..CHECKED_HASH]).then_some(())
+    }
+
+    /// The entry of `level` for the `nth` page that level covers.
+    fn entry(&self, level: &Range<u32>, nth: u32) -> Option<&[u8]> {
+        let page = self.pages.get((level.start + nth / ENTRIES) as usize)?;
+        let at = (nth % ENTRIES) as usize * 24;
+        page.get(at..at + 24)
+    }
+}
+
+/// The levels of the hash tree that hold pages, level 0 first: the top level's hash is in the
+/// header.
+fn levels(layout: &XvdLayout) -> Vec<Range<u32>> {
+    let tree = layout.hash_tree_layout;
+    [tree.level0, tree.level1, tree.level2, tree.level3]
+        .into_iter()
+        .take(usize::from(tree.top_level()) + 1)
+        .map(|level| level.page_range.start.0..level.page_range.end.0)
+        .collect()
+}
+
+/// The start of a partial answer's range: `bytes 4096-8191/8192` starts at 4096.
+fn range_start(response: &reqwest::Response) -> Option<u64> {
+    let range = response.headers().get(CONTENT_RANGE)?.to_str().ok()?;
+    range
+        .strip_prefix("bytes ")?
+        .split('-')
+        .next()?
+        .parse()
+        .ok()
+}
+
+/// The bytes free for the user on the volume of `file`.
+pub fn free_space(file: &Path) -> std::io::Result<u64> {
+    use std::os::unix::ffi::OsStrExt;
+
+    let directory = file.parent().unwrap_or(Path::new("."));
+    let path = std::ffi::CString::new(directory.as_os_str().as_bytes())?;
+    // SAFETY: statvfs is plain data, and the call fills it in.
+    let mut stats: libc::statvfs = unsafe { std::mem::zeroed() };
+    // SAFETY: a nul-terminated path and a statvfs to fill.
+    if unsafe { libc::statvfs(path.as_ptr(), &mut stats) } != 0 {
+        return Err(std::io::Error::last_os_error());
+    }
+    Ok(u64::from(stats.f_bavail) * stats.f_frsize)
+}
+
+#[cfg(test)]
+mod tests {
